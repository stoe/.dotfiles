#!/usr/bin/env fish

# Translated from the original zsh script/duti. Computes the repo root
# relative to this script's own location instead of relying on an inherited
# $DFH (per the Phase 0 audit finding that script/duti shouldn't depend on
# the caller's environment). Simplified to always `exit` (rather than zsh's
# is_sourced/safe_exit dance) since this script is meant to be run directly,
# not sourced.

function show_help
    echo "Usage: ./duti [-s|-i|-b]"
    echo "  -s  Use VSCode Stable"
    echo "  -i  Use VSCode Insiders"
    echo "  -b  Use both VSCode Stable and Insiders"
end

if not command -sq duti
    abort "Please \`brew install duti\` first"
    exit 1
end

# Detect installed VSCode variants
set -l has_stable 0
set -l has_insiders 0

if command -sq code; or test -d "/Applications/Visual Studio Code.app"
    set has_stable 1
end

if command -sq code-insiders; or test -d "/Applications/Visual Studio Code - Insiders.app"
    set has_insiders 1
end

# Check if at least one variant is installed
if test $has_stable -eq 0; and test $has_insiders -eq 0
    abort "No VSCode variant detected. Please install VSCode or VSCode-Insiders first."
    show_help
    exit 1
end

# Parse optional non-interactive selection flags
set -l cli_choice
set -l selected_flags 0

for arg in $argv
    switch $arg
        case -s
            set cli_choice s
            set selected_flags (math $selected_flags + 1)
        case -i
            set cli_choice i
            set selected_flags (math $selected_flags + 1)
        case -b
            set cli_choice b
            set selected_flags (math $selected_flags + 1)
        case -h --help
            show_help
            exit 0
        case '*'
            abort "Unknown option: $arg"
            show_help
            exit 1
    end
end

if test $selected_flags -gt 1
    abort "Please provide only one of -s, -i, or -b"
    show_help
    exit 1
end

# Build available options message
set -l available
if test $has_stable -eq 1; and test $has_insiders -eq 1
    set available "stable/insiders/both"
else if test $has_stable -eq 1
    set available "stable only"
else if test $has_insiders -eq 1
    set available "insiders only"
end

# Prompt user for selection when no CLI flag is provided
set -l choice $cli_choice
if test -z "$choice"
    question "Which VSCode variant to set as default?" "s/i/b"
    printf '  Available: \033[38;5;39m%s\033[0m\n' "$available"
    read -s -n 1 choice
    printf '\033[38;5;39m> %s\033[0m\n' "$choice"
else
    printf '\033[38;5;39mUsing flag selection: %s\033[0m\n' "$choice"
end

set -l normalized_choice (string lower -- "$choice")

# Validate and confirm selection
set -l variant
switch $normalized_choice
    case s
        if test $has_stable -eq 0
            abort "VSCode stable is not installed"
            show_help
            exit 1
        end
        set variant stable
    case i
        if test $has_insiders -eq 0
            abort "VSCode-Insiders is not installed"
            show_help
            exit 1
        end
        set variant insiders
    case b
        if test $has_stable -eq 0; or test $has_insiders -eq 0
            abort "Both variants are not installed"
            show_help
            exit 1
        end
        set variant both
    case '*'
        abort "Invalid selection. Please choose s, i, or b"
        show_help
        exit 1
end

ok "Setting default file associations for VSCode $variant"

# Function to set file associations for a given bundle identifier
function set_file_associations
    set -l bundle_id $argv[1]
    set -l label $argv[2]
    set -l failures 0

    printf '\nℹ \033[38;5;178mConfiguring %s\033[0m\n' "$label"

    set -l utis \
        public.json \
        public.plain-text \
        public.python-script \
        public.shell-script \
        public.source-code \
        public.text \
        public.unix-executable

    set -l extensions \
        .c .cfg .code-workspace .conf .cpp .cs .css .go .java .js .json .jsx \
        .less .log .lua .md .php .pl .py .rb .sass .scss .sh .toml .ts .tsx \
        .txt .vue .xml .yaml .yml .zsh

    set -l file_types $utis $extensions

    for file_type in $file_types
        # Some systems return -50 for unsupported/dynamic UTIs. Warn and continue.
        if not formatexec "duti -s $bundle_id $file_type all"
            printf '⚠ \033[38;5;178mskipping unsupported association\033[0m %s\n' "$file_type"
            set failures (math $failures + 1)
        end
    end

    if test $failures -gt 0
        printf '⚠ \033[38;5;178m%s: %s association(s) were skipped\033[0m\n' "$label" "$failures"
    end
end

# Execute based on user selection
switch $variant
    case stable
        set_file_associations com.microsoft.VSCode "VSCode Stable"
    case insiders
        set_file_associations com.microsoft.VSCodeInsiders "VSCode Insiders"
    case both
        set_file_associations com.microsoft.VSCode "VSCode Stable"
        set_file_associations com.microsoft.VSCodeInsiders "VSCode Insiders"
end

ok "File associations configured successfully"
