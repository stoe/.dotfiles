#!/usr/bin/env fish

#/ DESCRIPTION:
#/   Install Homebrew packages from machine-specific Brewfiles.
#/   Combines Brewfile, Brewfile.optional, and Brewfile.{work|personal}
#/   into a unified Brewfile.local based on the current machine hostname.
#/
#/ USAGE:
#/   install
#
# Translated from the original zsh script/brew/install. Relies on fish's
# automatic conf.d/functions autoloading (section/abort/ok/formatexec/disabled
# and the $RED/$NC/... color vars from config/fish/conf.d) instead of manually
# sourcing inc/common.zsh + inc/helpers.zsh.

set -l script_dir (dirname (status current-filename))

# Change to script directory to find Brewfiles
cd $script_dir

function sync_vscode_extensions
    set -l cli_name $argv[1]
    set -l editor_name $argv[2]

    if not command -sq $cli_name
        disabled
        printf '\033[38;5;244mSkipping %s extension sync (missing CLI: %s)\033[0m\n' "$editor_name" "$cli_name"
        return 0
    end

    set -l desired_extensions (sed -nE 's/^[[:space:]]*vscode[[:space:]]+"([^"]+)".*/\1/p' Brewfile.vsc)

    for extension in $desired_extensions
        # --force handles install and update with one command.
        # filter out deprecation warnings to avoid cluttering output
        formatexec "$cli_name --install-extension $extension --force" 2>&1 | grep -vE 'DeprecationWarning|--trace-deprecation'; or true
    end
end

# Machine hostnames come from 1Password when available. Environment variables
# can provide them after bootstrap, without requiring desktop integration.
set -l WORK_MACHINE_NAME "$WORK_MACHINE_NAME"
set -l PERSONAL_MACHINE_NAME "$PERSONAL_MACHINE_NAME"
if command -sq op; and op whoami >/dev/null 2>&1
    set WORK_MACHINE_NAME (op read 'op://Private/brewfiles/WORK_MACHINE/name')
    set PERSONAL_MACHINE_NAME (op read 'op://Private/brewfiles/PERSONAL_MACHINE/name')
end
set -l BREWFILE_LOCAL Brewfile.local

# Cleanup on exit to remove temporary Brewfile.local
function _cleanup_brewfile --on-event fish_exit
    test -f Brewfile.local; and rm -f Brewfile.local Brewfile.local.lock.json
end

section "homebrew" "🍺 💻 install"

# Verify required Brewfiles exist
if not test -f Brewfile
    abort "Brewfile not found"
    exit 1
end
if not test -f Brewfile.optional
    abort "Brewfile.optional not found"
    exit 1
end

# Get the local computer's hostname
set -l machine_name (hostname)

# Combine base Brewfiles (as a list of lines; joined into one string only
# when writing the file, avoiding fish's command-substitution line-splitting
# from corrupting embedded newlines in an intermediate string).
set -l brewfile_all (cat Brewfile) '' (cat Brewfile.optional)

# Load machine-specific Brewfile based on hostname
switch $machine_name
    case "$WORK_MACHINE_NAME"
        section "homebrew" "🍺 💼"
        if not test -f Brewfile.work
            abort "Brewfile.work not found"
            exit 1
        end
        set -a brewfile_all '' (cat Brewfile.work)
    case "$PERSONAL_MACHINE_NAME"
        section "homebrew" "🍺 🏡"
        if not test -f Brewfile.personal
            abort "Brewfile.personal not found"
            exit 1
        end
        set -a brewfile_all '' (cat Brewfile.personal)
    case '*'
        abort "Unknown machine name: $machine_name"
        exit 1
end

# Write unified Brewfile
string join \n -- $brewfile_all > $BREWFILE_LOCAL

# Execute brew bundle install
formatexec "brew bundle --file $BREWFILE_LOCAL"

# Sync extension state in both VS Code Stable and Insiders.
if not test -f Brewfile.vsc
    abort "Brewfile.vsc not found"
    exit 1
end
section "vscode" "🧩 insiders"
if not sync_vscode_extensions code-insiders "VS Code Insiders"
    disabled
    printf '\033[38;5;244mVS Code Insiders extension sync reported errors; continuing\033[0m\n'
end
section "vscode" "🧩 stable"
if not sync_vscode_extensions code "VS Code Stable"
    disabled
    printf '\033[38;5;244mVS Code Stable extension sync reported errors; continuing\033[0m\n'
end

echo ""
ok "homebrew 🍺 done"
