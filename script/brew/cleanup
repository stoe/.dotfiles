#!/usr/bin/env fish

#/ DESCRIPTION:
#/   Clean up Homebrew packages not listed in machine-specific Brewfiles.
#/   Removes packages, casks, and dependencies no longer needed.
#/
#/ USAGE:
#/   cleanup [--dry-run]
#/
#/ OPTIONS:
#/   --dry-run    Show what would be removed without making changes
#
# Translated from the original zsh script/brew/cleanup. Relies on fish's
# automatic conf.d/functions autoloading (section/abort/ok/formatexec) instead
# of manually sourcing inc/common.zsh + inc/helpers.zsh.

set -l script_dir (dirname (status current-filename))

# Change to script directory to find Brewfiles
cd $script_dir

function append_cleanup_ignored_apps
    set -l source_brewfile $argv[1]

    sed -nE 's|^[[:space:]]*#[[:space:]]*cleanup-ignore-app[[:space:]]+"([^"]+)"[[:space:]]+(.+)$|\1\t\2|p' $source_brewfile | while read -l -d \t app_path bundle_entry
        if test -z "$app_path"; or test -z "$bundle_entry"
            continue
        end

        if test -e "$app_path"
            set -ag brewfile_all $bundle_entry
            section "homebrew" "🍺 🙅 Ignoring cleanup for $app_path"
        end
    end
end

# Machine hostnames come from 1Password when available. Environment variables
# can provide them after bootstrap, without requiring desktop integration.
set -l WORK_MACHINE_NAME "$WORK_MACHINE_NAME"
set -l PERSONAL_MACHINE_NAME "$PERSONAL_MACHINE_NAME"
if command -sq op; and op whoami >/dev/null 2>&1
    set WORK_MACHINE_NAME (op read 'op://Private/brewfiles/WORK_MACHINE/name')
    set PERSONAL_MACHINE_NAME (op read 'op://Private/brewfiles/PERSONAL_MACHINE/name')
end
set -l BREWFILE_LOCAL Brewfile.local

function _cleanup_brewfile --on-event fish_exit
    test -f Brewfile.local; and rm -f Brewfile.local Brewfile.local.lock.json
end

# Parse command-line arguments
set -l dry_run false
if test "$argv[1]" = --dry-run
    set dry_run true
    section "dry run" "🍺 🙈 No changes will be made"
else
    section "homebrew" "🍺 💻 cleanup"
end

# Remove existing Brewfile.local if present
if test -f $BREWFILE_LOCAL
    section "homebrew" "🍺 🧹 Cleaning existing $BREWFILE_LOCAL"
    rm -f $BREWFILE_LOCAL "$BREWFILE_LOCAL.lock.json" 2>/dev/null
end

# Verify required Brewfiles exist
if not test -f Brewfile
    abort "Brewfile not found"
    exit 1
end
if not test -f Brewfile.optional
    abort "Brewfile.optional not found"
    exit 1
end

# Get the local computer's hostname
set -l machine_name (hostname)

# Combine base Brewfiles (as a list of lines; joined into one string only
# when writing the file, avoiding fish's command-substitution line-splitting
# from corrupting embedded newlines in an intermediate string).
set -g brewfile_all (cat Brewfile) '' (cat Brewfile.optional)

# Load machine-specific Brewfile based on hostname
set -l machine_brewfile
switch $machine_name
    case "$WORK_MACHINE_NAME"
        section "homebrew" "🍺 💼"
        if not test -f Brewfile.work
            abort "Brewfile.work not found"
            exit 1
        end
        set machine_brewfile Brewfile.work
        set -ag brewfile_all '' (cat Brewfile.work)
    case "$PERSONAL_MACHINE_NAME"
        section "homebrew" "🍺 🏡"
        if not test -f Brewfile.personal
            abort "Brewfile.personal not found"
            exit 1
        end
        set machine_brewfile Brewfile.personal
        set -ag brewfile_all '' (cat Brewfile.personal)
    case '*'
        abort "Unknown machine name: $machine_name"
        exit 1
end

# Keep selected apps during cleanup when listed in the active machine Brewfile.
append_cleanup_ignored_apps $machine_brewfile

# Add VS Code extensions
if not test -f Brewfile.vsc
    abort "Brewfile.vsc not found"
    exit 1
end
set -ag brewfile_all '' (cat Brewfile.vsc)

# Write unified Brewfile
string join \n -- $brewfile_all > $BREWFILE_LOCAL

# Run brew bundle cleanup (may return 1 in dry-run mode if packages would be removed)
set -l cmd "brew bundle cleanup --file $BREWFILE_LOCAL"
test "$dry_run" = false; and set cmd "$cmd --force"
echo ""
formatexec "$cmd"; or true

# Run brew autoremove to clean up lingering dependencies
set -l cmd2 "brew autoremove"
test "$dry_run" = true; and set cmd2 "$cmd2 --dry-run"
echo ""
formatexec "$cmd2"; or true

echo ""
ok "homebrew 🍺 done"
