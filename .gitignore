### dotfiles ###

# Copilot and editor tooling state
.copilot-memory/
.ruby-lsp/*
!.ruby-lsp/Gemfile
!.ruby-lsp/Gemfile.lock

# Only the Copilot instructions are shared; other instruction files stay local
.github/instructions/*.md
!.github/instructions/copilot-instructions.instructions.md

# ~/.config is a symlink to config/, so only track what we maintain
config/*
!config/.pdfpw
!config/.zippw
!config/gh/
config/gh/*
!config/gh/config.yml
!config/rubocop/
config/rubocop/*
!config/rubocop/config.yml
!config/fish
config/fish/*
!config/fish/config.fish
!config/fish/conf.d
!config/fish/functions
!config/fish/fish_plugins

# Track our own conf.d files, but re-ignore Fisher/Tide's vendored startup
# hooks (regenerated by `fisher update` from fish_plugins, so committing them
# would just cause drift against the plugins' actual releases).
config/fish/conf.d/_tide_init.fish
config/fish/conf.d/fzf.fish

# Track our own functions, but re-ignore Fisher/Tide's vendored functions
# (same reasoning as above) — their private helpers are all underscore- or
# tide/-prefixed, plus a few top-level plugin entry points.
config/fish/functions/_*
config/fish/functions/tide/
config/fish/functions/tide.fish
config/fish/functions/fisher.fish
config/fish/functions/fzf_configure_bindings.fish
config/fish/functions/fish_prompt.fish
config/fish/functions/fish_mode_prompt.fish

# Fisher/Tide also generate completions from fish_plugins; nothing custom
# lives there, so the whole directory stays ignored (not re-included above).

# Local/private overrides symlinked in from outside the repo (e.g.
# .gitconfig.personal.local, .config.personal.local.fish); the real files
# live in ~/Documents/.dotfiles/ and must never be committed here
*.local
*.local.fish

# Never commit npm credentials
.npmrc

# Created by https://www.toptal.com/developers/gitignore/api/fish,homebrew,linux,macos,node,visualstudiocode,windows
# Edit at https://www.toptal.com/developers/gitignore?templates=fish,homebrew,linux,macos,node,visualstudiocode,windows

