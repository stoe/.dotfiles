# Normalize text files to LF; this repo only targets macOS
* text=auto eol=lf

# Function-aware diff hunk headers
*.fish     diff=bash
*.md       diff=markdown
Brewfile*  diff=ruby
Gemfile    diff=ruby

# GitHub language detection
Brewfile*         linguist-language=Ruby
.vscode/**/*.json linguist-language=JSON-with-Comments

# Collapse generated lockfiles in GitHub diffs
package-lock.json       linguist-generated=true
.ruby-lsp/Gemfile.lock  linguist-generated=true
